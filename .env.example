# =============================================================================
# .env.example — B 路线 (ASP.NET Core net8.0)
# 复制为 .env 后按需修改。compose 会自动读取。
# =============================================================================

# --- 应用容器 ---
# 容器内端口固定为 5001（appsettings.json 的 Urls 键），宿主机端口可改
APP_HTTP_PORT=5001

# ASP.NET Core 环境（决定加载哪个 appsettings.{env}.json）
# ConfigHelper.cs:24 只在 envName 非空时加载 appsettings.{env}.json
# 设为 Production 才会加载 appsettings.Production.json
ASPNETCORE_ENVIRONMENT=Production

# --- 数据库（SQL Server 容器） ---
DB_IMAGE_TAG=2025-latest
# Developer=免费（功能限制 10GB / 1CPU / 64MB 内存）；Standard=付费（16 用户）；Enterprise=付费（无限制）
# 见 https://docs.microsoft.com/en-us/sql/sql-server/editions-and-components-of-sql-server
DB_PID=Developer
# 至少 8 位，含大小写字母 + 数字 + 符号
DB_SA_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD_16+
# 宿主机暴露的 SQL 端口（1433 是默认；若本机已占可用 11433）
DB_HOST_PORT=127.0.0.1:1433

# --- 连接串 ---
# ⚠ 重要：B 源码的 ConfigHelper.cs:20-29 只读 JSON 文件，不读环境变量！
#    所以不能通过 docker-compose.yml 的 environment 段覆盖 type/connectionString。
#    必须通过挂载 appsettings.Production.json 实现（见本目录 README.md 第 4 节）。
#    下面的占位符仅供文档参考，实际生效靠 appsettings.Production.json。
DB_TYPE=SqlServer
DB_CONNECTIONSTRING=Server=db,1433;Database=XHDCRM3;User Id=sa;Password=${DB_SA_PASSWORD};TrustServerCertificate=True;Encrypt=True

# --- 可选：切换到 SQLite（无需 SQL Server 容器） ---
# 设 USE_SQLITE=true 并注释掉 docker-compose.yml 中的 db 服务与 depends_on
USE_SQLITE=false
