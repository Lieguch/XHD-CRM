@{
    ViewData["Title"] = "任务管理";
}

<style type="text/css">
    .task-status-0 { background: #52c41a; color: #fff; padding: 2px 8px; border-radius: 3px; }
    .task-status-1 { background: #f5222d; color: #fff; padding: 2px 8px; border-radius: 3px; }
    .task-status-2 { background: #1890ff; color: #fff; padding: 2px 8px; border-radius: 3px; }
    .task-priority-0 { color: #f5222d; font-weight: 600; }
    .task-priority-1 { color: #faad14; font-weight: 600; }
    .task-priority-2 { color: #52c41a; font-weight: 600; }
    .task-overdue { background: #ffe7e7 !important; }
    .task-follow-detail { padding: 8px 16px; background: #fafafa; }
    .task-follow-detail .layui-table { margin-top: 8px; }
</style>

<div class="table-search-fieldset">
    <div>
        <form class="layui-form layui-form-pane" action="">
            <div class="layui-form-item layui-inline">
                <label class="layui-form-label">任务标题</label>
                <div class="layui-input-inline">
                    <input type="text" name="task_title" id="task_title" autocomplete="off" class="layui-input" placeholder="任务标题">
                </div>
            </div>
            <div class="layui-form-item layui-inline">
                <label class="layui-form-label">状态</label>
                <div class="layui-input-inline">
                    <select id="task_status_id" name="task_status_id">
                        <option value="">全部</option>
                        <option value="0">进行中</option>
                        <option value="1">已完成</option>
                        <option value="2">已中止</option>
                    </select>
                </div>
            </div>
            <div class="layui-form-item layui-inline">
                <label class="layui-form-label">优先级</label>
                <div class="layui-input-inline">
                    <select id="priority_id" name="priority_id">
                        <option value="">全部</option>
                        <option value="0">高</option>
                        <option value="1">中</option>
                        <option value="2">低</option>
                    </select>
                </div>
            </div>
            <div class="layui-form-item layui-inline">
                <label class="layui-form-label">执行人</label>
                <div class="layui-input-inline">
                    <input type="text" name="executive_name" id="executive_name" placeholder="执行人" autocomplete="off" class="layui-input">
                    <input type="hidden" name="executive_id" id="executive_id">
                </div>
            </div>
            <div class="layui-form-item">
                <button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn" id="btn_serch"><i class="layui-icon layui-icon-search"></i> 搜索</button>
                <button type="reset" class="layui-btn layui-btn-primary" id="btn_reset"><i class="layui-icon layui-icon-error"></i> 重置</button>
            </div>
        </form>
    </div>
</div>

<div class="layuimini-card">
    <div class="layui-card-body">
        <table id="task-table" class="layui-table" lay-filter="taskTableFilter"></table>
    </div>
</div>

<script type="text/html" id="toolbarDemo">
    <div class="layui-btn-container">
        <button class="layui-btn layui-btn-sm" lay-event="add">添加</button>
        <button class="layui-btn layui-btn-sm layui-bg-orange" lay-event="mytodo">我的待办</button>
    </div>
</script>

<script type="text/html" id="op-demo">
    <a class="layui-btn layui-btn-xs layui-btn-primary" lay-event="detail">明细</a>
    <a class="layui-btn layui-btn-xs" lay-event="edit">编辑</a>
    <a class="layui-btn layui-btn-xs layui-bg-blue" lay-event="finish">完成</a>
    <a class="layui-btn layui-btn-xs layui-btn-warm" lay-event="abort">中止</a>
    <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="del">删除</a>
</script>

