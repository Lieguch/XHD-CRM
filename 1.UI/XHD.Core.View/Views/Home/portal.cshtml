@{
    ViewData["Title"] = "工作台";
    Layout = null;

    var hour = DateTime.Now.Hour;
    var hello = hour < 12 ? "早上好" : (hour < 18 ? "下午好" : "晚上好");
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>工作台</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <link rel="icon" href="~/layuimini/images/favicon.ico">
    <link rel="stylesheet" href="~/layuimini/lib/layui-v2.9.6/css/layui.css" media="all">
    <link rel="stylesheet" href="~/layuimini/css/layuimini.css?v=2.0.3" media="all">
    <link rel="stylesheet" href="~/layuimini/lib/font-awesome-4.7.0/css/font-awesome.min.css" media="all">
    <style>
        body {
            padding: 15px;
            background-color: #f2f2f2;
        }

        .portal-greeting {
            padding: 15px 20px;
            margin-bottom: 15px;
            background-color: #fff;
            border-radius: 4px;
            box-shadow: 0 1px 4px rgba(0, 0, 0, .06);
        }

            .portal-greeting h2 {
                font-size: 20px;
                margin: 0;
            }

            .portal-greeting p {
                margin: 8px 0 0;
                color: #666;
                font-size: 13px;
            }

        .portal-row {
            margin-bottom: 15px;
        }

        .layuimini-card .layui-card-header {
            position: relative;
            height: 42px;
            line-height: 42px;
            padding: 0 15px;
            border-bottom: 1px solid #f6f6f6;
            color: #333;
            font-size: 14px;
        }

            .layuimini-card .layui-card-header i {
                margin-right: 8px;
                color: #5FB878;
            }

        .portal-more {
            position: absolute;
            right: 15px;
            top: 0;
            font-size: 12px;
            color: #5FB878;
        }

        .portal-list {
            margin: 0;
            padding: 0;
            list-style: none;
            min-height: 40px;
        }

            .portal-list li {
                padding: 8px 15px;
                border-bottom: 1px solid #f6f6f6;
                font-size: 13px;
                overflow: hidden;
            }

                .portal-list li:last-child {
                    border-bottom: none;
                }

                .portal-list li a {
                    color: #333;
                    display: block;
                    overflow: hidden;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                }

                    .portal-list li a:hover {
                        color: #5FB878;
                    }

                .portal-list li .portal-time {
                    float: right;
                    color: #999;
                    font-size: 12px;
                    margin-left: 10px;
                }

        .portal-empty {
            text-align: center;
            color: #999;
            font-size: 13px;
            padding: 20px 0;
            line-height: 40px;
        }

        .portal-fail {
            text-align: center;
            color: #FF5722;
            font-size: 13px;
            padding: 20px 0;
        }

        .portal-quick a {
            display: block;
            padding: 10px 15px;
            color: #333;
            font-size: 13px;
            border-bottom: 1px solid #f6f6f6;
        }

            .portal-quick a:last-child {
                border-bottom: none;
            }

            .portal-quick a:hover {
                color: #5FB878;
            }

            .portal-quick a i {
                width: 20px;
                margin-right: 8px;
                color: #5FB878;
            }
    </style>
</head>
<body>
    <div class="portal-greeting">
        <h2>@hello，@ViewData["user_name"]</h2>
        <p>@DateTime.Now.ToString("yyyy年MM月dd日 dddd")，祝您工作顺利！</p>
    </div>

    <div class="layui-row portal-row">
        <div class="layui-col-md4">
            <div class="layuimini-card">
                <div class="layui-card-header">
                    <i class="fa fa-tasks"></i>我的任务
                    <a href="javascript:;" class="portal-more" onclick="openTab('Task/Index','任务管理')">更多</a>
                </div>
                <div class="layui-card-body">
                    <ul class="portal-list" id="list-task"></ul>
                </div>
            </div>
        </div>
        <div class="layui-col-md4">
            <div class="layuimini-card">
                <div class="layui-card-header">
                    <i class="fa fa-newspaper-o"></i>公司新闻
                    <a href="javascript:;" class="portal-more" onclick="openTab('MessageNews/Index','新闻公告')">更多</a>
                </div>
                <div class="layui-card-body">
                    <ul class="portal-list" id="list-news"></ul>
                </div>
            </div>
        </div>
        <div class="layui-col-md4">
            <div class="layuimini-card">
                <div class="layui-card-header">
                    <i class="fa fa-bullhorn"></i>公司公告
                    <a href="javascript:;" class="portal-more" onclick="openTab('MessageNews/Index','新闻公告')">更多</a>
                </div>
                <div class="layui-card-body">
                    <ul class="portal-list" id="list-notice"></ul>
                </div>
            </div>
        </div>
    </div>

    <div class="layui-row portal-row">
        <div class="layui-col-md4">
            <div class="layuimini-card">
                <div class="layui-card-header">
                    <i class="fa fa-bookmark"></i>我的便签
                    <a href="javascript:;" class="portal-more" onclick="openTab('MyNote/Index','我的便签')">更多</a>
                </div>
                <div class="layui-card-body">
                    <ul class="portal-list" id="list-note"></ul>
                </div>
            </div>
        </div>
        <div class="layui-col-md4">
            <div class="layuimini-card">
                <div class="layui-card-header">
                    <i class="fa fa-calendar"></i>今日日程
                    <a href="javascript:;" class="portal-more" onclick="openTab('MyCalendar/Index','我的日程')">更多</a>
                </div>
                <div class="layui-card-body">
                    <ul class="portal-list" id="list-calendar"></ul>
                </div>
            </div>
        </div>
        <div class="layui-col-md4">
            <div class="layuimini-card">
                <div class="layui-card-header">
                    <i class="fa fa-th-large"></i>常用入口
                </div>
                <div class="layui-card-body portal-quick">
                    <a href="javascript:;" onclick="openTab('Customer/Index','客户管理')"><i class="fa fa-user"></i>客户管理</a>
                    <a href="javascript:;" onclick="openTab('CRMFollow/Index','跟进管理')"><i class="fa fa-phone-square"></i>跟进管理</a>
                    <a href="javascript:;" onclick="openTab('SaleOrder/Index','订单管理')"><i class="fa fa-copy"></i>订单管理</a>
                    <a href="javascript:;" onclick="openTab('Home/home','数据大屏')"><i class="fa fa-dashboard"></i>数据大屏</a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/layuimini/lib/layui-v2.9.6/layui.js" charset="utf-8"></script>
    <script src="~/layuimini/js/lay-config.js?v=3.0.030201" charset="utf-8"></script>
    <script src="~/js/XHD.js?v=3.0.030201" charset="utf-8"></script>
    <script>
        var openTab;

        //时间格式化：兼容 /Date(...)/ 时间戳与 ISO 字符串两种返回
        function portalDate(val) {
            if (!val) return "";
            if (typeof val === "string" && val.indexOf("Date(") < 0 && !/^-?\d+$/.test(val)) {
                var d = new Date(val);
                if (isNaN(d)) return val;
                return d.format("yyyy-MM-dd");
            }
            return formatTimebytype(val, "yyyy-MM-dd");
        }

        layui.use(['jquery'], function () {
            var $ = layui.jquery;

            //在父窗口的 iframe tab 中打开管理页（沿用 Index.cshtml 的 miniTab 范式）
            openTab = function (href, title) {
                try {
                    var p = window.parent;
                    if (p && p.layui && p.layui.miniTab) {
                        var tabId = href;
                        if (!p.layui.miniTab.check(tabId, true)) {
                            p.layui.miniTab.create({ tabId: tabId, href: href, title: title, isIframe: true });
                        }
                        p.layui.miniTab.change(tabId);
                    }
                } catch (e) {
                    console.warn(e);
                }
            };

            //单个面板加载：成功渲染列表，失败显示「加载失败」，互不影响
            function loadPanel(el, url, renderRow) {
                $.getJSON(url, function (res) {
                    try {
                        var data = (res && res.code === 0 && $.isArray(res.data)) ? res.data : [];
                        if (data.length === 0) {
                            el.html('<li class="portal-empty">暂无数据</li>');
                            return;
                        }
                        var html = "";
                        for (var i = 0; i < data.length; i++) {
                            html += renderRow(data[i]);
                        }
                        el.html(html);
                    } catch (e) {
                        el.html('<li class="portal-fail">加载失败</li>');
                    }
                }).fail(function () {
                    el.html('<li class="portal-fail">加载失败</li>');
                });
            }

            loadPanel($("#list-task"), "/Task/Remind?limit=7", function (item) {
                var title = item.task_title || "（无标题）";
                return '<li><a href="javascript:;" onclick="openTab(\'Task/Index\',\'任务管理\')" title="' + title + '">' +
                    '<span class="portal-time">' + portalDate(item.executive_time) + '</span>' + title + '</a></li>';
            });

            loadPanel($("#list-news"), "/MessageNews/NewsRemind?limit=5", function (item) {
                var title = item.news_title || "（无标题）";
                return '<li><a href="javascript:;" onclick="openTab(\'MessageNews/Index\',\'新闻公告\')" title="' + title + '">' +
                    '<span class="portal-time">' + portalDate(item.create_time) + '</span>' + title + '</a></li>';
            });

            loadPanel($("#list-notice"), "/MessageNews/NoticeRemind?limit=10", function (item) {
                var title = item.news_title || "（无标题）";
                return '<li><a href="javascript:;" onclick="openTab(\'MessageNews/Index\',\'新闻公告\')" title="' + title + '">' +
                    '<span class="portal-time">' + portalDate(item.create_time) + '</span>' + title + '</a></li>';
            });

            loadPanel($("#list-note"), "/MyNote/Remind?limit=10", function (item) {
                var title = item.content || "（无内容）";
                return '<li><a href="javascript:;" onclick="openTab(\'MyNote/Index\',\'我的便签\')" title="' + title + '">' +
                    '<span class="portal-time">' + portalDate(item.Note_time) + '</span>' + title + '</a></li>';
            });

            loadPanel($("#list-calendar"), "/MyCalendar/Today", function (item) {
                var title = item.title || "（无标题）";
                return '<li><a href="javascript:;" onclick="openTab(\'MyCalendar/Index\',\'我的日程\')" title="' + title + '">' +
                    '<span class="portal-time">' + portalDate(item.StartDateTime) + '</span>' + title + '</a></li>';
            });
        });
    </script>
</body>
</html>
