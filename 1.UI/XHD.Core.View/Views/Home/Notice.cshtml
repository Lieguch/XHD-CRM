@{
    ViewData["Title"] = "公告管理";
}

<div class="table-search-fieldset">
    <div style="margin: 10px 10px 10px 10px">
        <form class="layui-form layui-form-pane" action="">
            <div class="layui-form-item">
                <div class="layui-inline">
                    <label class="layui-form-label">标题</label>
                    <div class="layui-input-inline">
                        <input type="text" name="title" id="title" placeholder="公告标题" autocomplete="off" class="layui-input">
                    </div>
                </div>

                <div class="layui-inline">
                    <label class="layui-form-label">发布时间</label>
                    <div class="layui-input-inline" style="width: 100px;">
                        <input type="text" name="date1" id="date1" placeholder="yyyy-MM-dd" autocomplete="off" class="layui-input">
                    </div>
                    <div class="layui-form-mid">-</div>
                    <div class="layui-input-inline" style="width: 100px;">
                        <input type="text" name="date2" id="date2" placeholder="yyyy-MM-dd" autocomplete="off" class="layui-input">
                    </div>
                </div>

                <div class="layui-inline">
                    <button type="button" class="layui-btn layui-btn-primary" id="data-search-btn"><i class="layui-icon"></i> 搜 索</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="layuimini-card">
    <div class="layui-card-body">
        <table class="layui-hide" id="currentTableId" lay-filter="currentTableFilter"></table>
    </div>
</div>

<!-- 工具栏 -->
<script type="text/html" id="toolbarDemo">
    <div class="layui-btn-container">
        <button class="layui-btn layui-btn-normal layui-btn-sm" lay-event="add"><i class="layui-icon"></i>新增公告</button>
    </div>
</script>

<!-- 操作列 -->
<script type="text/html" id="auth-state">
    <a class="layui-btn layui-btn-normal layui-btn-xs" lay-event="edit">编辑</a>
    <a class="layui-btn layui-btn-danger layui-btn-xs" lay-event="del">删除</a>
</script>

<script>
    layui.use(['form', 'table', 'laydate', 'openTable'], function () {
        var $ = layui.jquery,
            form = layui.form,
            table = layui.table,
            laydate = layui.laydate,
            openTable = layui.openTable;

        // 日期选择器
        laydate.render({ elem: '#date1' });
        laydate.render({ elem: '#date2' });

        openTable.render({
            elem: '#currentTableId',
            url: 'Grid',
            toolbar: '#toolbarDemo',
            defaultToolbar: ['filter'],
            id: "mainGrid1",
            cols: [[
                { type: 'numbers' },
                { field: 'title', minWidth: 200, title: '公告标题' },
                { field: 'content', minWidth: 300, title: '内容摘要' },
                { field: 'create_time', width: 180, title: '发布时间' },
                { field: 'create_name', width: 120, title: '发布人' },
                { templet: '#auth-state', width: 120, align: 'center', title: '操作' }
            ]],
            openCols: [
                { field: 'content', title: '公告内容' }
            ],
            limits: [10, 15, 20, 25, 50, 100],
            limit: 15,
            page: true
        });

        // 监听工具条
        table.on('toolbar(currentTableFilter)', function (obj) {
            if (obj.event === 'add') {
                layer.open({
                    title: '新增公告',
                    type: 2,
                    anim: 1,
                    area: ['800px', '500px'],
                    content: 'Add'
                });
            }
        });

        // 监听操作列
        table.on('tool(currentTableFilter)', function (obj) {
            var data = obj.data;
            var layEvent = obj.event;

            if (layEvent === 'edit') {
                layer.open({
                    title: '编辑公告',
                    type: 2,
                    anim: 1,
                    area: ['800px', '500px'],
                    content: 'Edit?id=' + data.id
                });
            }

            if (layEvent === 'del') {
                layer.confirm('确定删除该公告？', { icon: 3, title: '提示信息' }, function (index) {
                    del(data.id);
                    layer.close(index);
                });
            }
        });

        function del(id) {
            $.ajax({
                type: 'POST',
                url: "Delete",
                data: { id: id },
                dataType: "json",
                success: function (res) {
                    if (res.code == 0) {
                        f_reload();
                    } else {
                        layer.alert(res.msg, { icon: 5 });
                    }
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    layer.alert('操作失败！！！' + XMLHttpRequest.status + "|" + XMLHttpRequest.readyState + "|" + textStatus, { icon: 5 });
                }
            });
        }

        // 搜索按钮
        $("#data-search-btn").on("click", function () {
            table.reload("mainGrid1", {
                page: { curr: 1 },
                where: {
                    title: $("#title").val(),
                    date1: $("#date1").val(),
                    date2: $("#date2").val()
                }
            });
        });

        function f_reload(id) {
            var curr = $(".layui-laypage-skip").find("input").val();
            if (!curr) { curr = 1; }
            table.reload('mainGrid1', {
                page: { curr: curr },
                where: {
                    title: $("#title").val(),
                    date1: $("#date1").val(),
                    date2: $("#date2").val()
                }
            }, 'data');
        }
    });
</script>
