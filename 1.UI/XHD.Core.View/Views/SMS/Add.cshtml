@{
    ViewData["Title"] = "短信 新增/编辑";
}

<div class="layui-form layui-form-pane" action="">
    @Html.Hidden("id")
    @Html.Hidden("contact_ids")
    <div class="layui-card">
        <div class="layui-card-header">发送短信</div>
        <div class="layui-card-body">
            <div class="layui-form-item">
                <label class="layui-form-label required">短信主题</label>
                <div class="layui-input-inline" style="width:480px;">
                    <input type="text" name="sms_title" id="sms_title" autocomplete="off" placeholder="请输入短信主题" class="layui-input" lay-verify="required" maxlength="50">
                </div>
            </div>

            <div class="layui-form-item layui-form-text">
                <label class="layui-form-label required">短信内容</label>
                <div class="layui-input-block">
                    <textarea id="sms_content" name="sms_content" placeholder="请输入短信内容（可含【公司名】签名）" class="layui-textarea" lay-verify="required" maxlength="1000" style="width:760px;height:140px;" onkeyup="updateCharCount()"></textarea>
                    <div id="char-count" style="text-align:right;font-size:12px;color:#999;margin-top:4px;">0 / 1000 字符</div>
                </div>
            </div>

            <div class="layui-form-item layui-form-text">
                <label class="layui-form-label required">手机号</label>
                <div class="layui-input-block">
                    <textarea id="sms_mobiles" name="sms_mobiles" placeholder="多个手机号请用逗号、分号或换行分隔，例如：13800138000,13900139000" class="layui-textarea" lay-verify="required" style="width:760px;height:100px;" onkeyup="updateMobileCount()"></textarea>
                    <div id="mobile-count" style="text-align:right;font-size:12px;color:#999;margin-top:4px;">0 个号码</div>
                    <div style="margin-top:6px;font-size:12px;color:#999;">注：每行/每段为一个手机号，最多 200 个；不合规的号码将被拒绝保存。</div>
                </div>
            </div>

            <div class="layui-form-item">
                <label class="layui-form-label">选择联系人</label>
                <div class="layui-input-inline">
                    <button type="button" class="layui-btn layui-btn-sm" id="btn-pick-contact"><i class="layui-icon layui-icon-add-1"></i> 从联系人选择</button>
                </div>
            </div>

            <div class="layui-form-item layui-hide">
                <input type="button" lay-submit lay-filter="LAY-user-front-submit" id="LAY-user-front-submit" value="确认">
            </div>
        </div>
    </div>
</div>

<script>
    function updateCharCount() {
        var len = $('#sms_content').val().length;
        $('#char-count').text(len + ' / 1000 字符');
        if (len > 800) $('#char-count').css('color', '#FF5722');
        else $('#char-count').css('color', '#999');
    }

    function updateMobileCount() {
        var text = $('#sms_mobiles').val();
        var mobiles = text.split(/[,\s;\n]+/).filter(function(m) { return m.length > 0; });
        $('#mobile-count').text(mobiles.length + ' 个号码');
        if (mobiles.length > 150) $('#mobile-count').css('color', '#FF5722');
        else $('#mobile-count').css('color', '#999');
    }

    layui.use(['form', 'layer', 'table', 'tableSelect'], function () {
        var form = layui.form;
        var $ = layui.$;
        var layer = layui.layer;
        var tableSelect = layui.tableSelect;

        form.render();
        updateCharCount();
        updateMobileCount();

        // 从联系人选择手机号
        $('#btn-pick-contact').on('click', function () {
            var idx = layer.open({
                type: 1,
                title: '选择联系人',
                area: ['700px', '500px'],
                content: '<iframe src="/CRM_Contact/Grid?mobile_only=1" style="width:100%;height:100%;border:0;"></iframe>',
                success: function (layero, index) {
                    var iframe = layero.find('iframe')[0];
                    iframe.onload = function () {
                        // 监听 iframe 中的选择事件
                    };
                }
            });
        });
    });
</script>