@{
    ViewData["Title"] = "应收账款 新增/编辑";
}

<div class="layui-form layui-form-pane" action="">
    @Html.Hidden("id")
    @Html.Hidden("order_id")
    <div class="layui-card">
        <div class="layui-card-header">应收单</div>
        <div class="layui-card-body">
            <div class="layui-form-item">
                <div class="layui-inline">
                    <label class="layui-form-label required">应收单号</label>
                    <div class="layui-input-inline">
                        <input type="text" name="receivable_no" id="receivable_no" autocomplete="off" placeholder="应收单号" class="layui-input" lay-verify="required">
                    </div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label required">关联订单</label>
                    <div class="layui-input-inline">
                        <input type="text" name="order" id="order" autocomplete="off" placeholder="订单号（点击选择）" class="layui-input" lay-verify="required">
                    </div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label">关联客户</label>
                    <div class="layui-input-inline">
                        <input type="text" id="cus_name_disp" autocomplete="off" placeholder="关联客户" class="layui-input" readonly>
                    </div>
                </div>
            </div>
            <div class="layui-form-item">
                <div class="layui-inline">
                    <label class="layui-form-label">订单金额</label>
                    <div class="layui-input-inline">
                        <input type="number" id="order_amount" autocomplete="off" placeholder="订单金额" class="layui-input" readonly>
                    </div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label required">应收金额</label>
                    <div class="layui-input-inline">
                        <input type="number" step="0.01" name="receivable_amount" id="receivable_amount" autocomplete="off" placeholder="应收金额" class="layui-input" lay-verify="required">
                    </div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label">已收金额</label>
                    <div class="layui-input-inline">
                        <input type="number" step="0.01" name="received_amount" id="received_amount" autocomplete="off" placeholder="已收金额" class="layui-input">
                    </div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label">未收余额</label>
                    <div class="layui-input-inline">
                        <input type="number" step="0.01" name="arrears_amount" id="arrears_amount" autocomplete="off" placeholder="未收余额" class="layui-input">
                    </div>
                </div>
            </div>
            <div class="layui-form-item">
                <label class="layui-form-label required">应收日期</label>
                <div class="layui-input-inline">
                    <input type="text" name="receivable_time" id="receivable_time" autocomplete="off" placeholder="yyyy-MM-dd" class="layui-input" lay-verify="required">
                </div>
            </div>
            <div class="layui-form-item layui-form-text">
                <label class="layui-form-label">备注</label>
                <div class="layui-input-block">
                    <textarea id="Remark" name="Remark" placeholder="请输入备注" class="layui-textarea"></textarea>
                </div>
            </div>
            <div class="layui-form-item layui-hide">
                <input type="button" lay-submit lay-filter="LAY-user-front-submit" id="LAY-user-front-submit" value="确认">
            </div>
        </div>
    </div>
</div>

<script>
    layui.use(['form', 'layer', 'tableSelect', 'table', 'laydate'], function () {
        var form = layui.form;
        var layer = layui.layer;
        var $ = layui.$;
        var table = layui.table;
        var laydate = layui.laydate;
        var tableSelect = layui.tableSelect;

        laydate.render({
            elem: '#receivable_time',
            trigger: 'click',
            value: new Date().toISOString().split('T')[0]
        });

        // 订单选择器
        tableSelect.render({
            elem: '#order',
            checkedKey: 'id',
            table: {
                url: '/SaleOrder/grid',
                width: 500,
                cols: [[
                    { type: 'radio' },
                    {
                        field: 'cus_name', width: 220, title: '客户', templet: function (t) {
                            return t.customer ? t.customer.cus_name : "";
                        }
                    },
                    { field: 'sn', width: 200, title: '订单号' },
                    {
                        field: 'Order_date', width: 120, title: '订单时间', templet: function (item) {
                            var v = item.Order_date;
                            if (v && !isNaN(Date.parse(v))) {
                                v = v.replace(' 00:00:00', '');
                            }
                            return v || "";
                        }
                    },
                    { field: 'Order_amount', width: 120, title: '订单金额', align: 'right' }
                ]]
            },
            done: function (elem, data) {
                var rows = data.data || [];
                if (rows.length === 0) return;
                var r = rows[0];
                $("#order_id").val(r.id);
                $("#cus_name_disp").val(r.customer ? r.customer.cus_name : "");
                $("#order_amount").val(r.Order_amount);
                // 新增时默认带出订单金额
                if (!$("#receivable_amount").val()) {
                    $("#receivable_amount").val(r.Order_amount);
                    calcArrears();
                }
            }
        });

        function calcArrears() {
            var recv = parseFloat($("#receivable_amount").val()) || 0;
            var recd = parseFloat($("#received_amount").val()) || 0;
            var diff = recv - recd;
            if (diff < 0) diff = 0;
            $("#arrears_amount").val(diff.toFixed(2));
        }

        $("#receivable_amount").on("input", calcArrears);
        $("#received_amount").on("input", calcArrears);

        // 生成一个默认应收单号（若为空）
        if (!$("#receivable_no").val()) {
            var now = new Date();
            var pad = function (n) { return n < 10 ? "0" + n : n; };
            var ymd = now.getFullYear() + pad(now.getMonth() + 1) + pad(now.getDate());
            var rnd = Math.floor(Math.random() * 9000 + 1000);
            $("#receivable_no").val("AR" + ymd + rnd);
        }
    });
</script>
