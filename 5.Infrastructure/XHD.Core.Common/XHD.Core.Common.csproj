<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Sprint 10.30: 抑制 nullable 引用警告（历史遗留代码，量级 300+，非缺陷）-->
    <NoWarn>CS8600;CS8602;CS8604;CS8625;CS8629;CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FreeSql" Version="3.5.310" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <!-- Sprint 10.30b: 升级到 8.0.2 消除 NU1605（Caching.Memory 8.0.1 要求 >=8.0.2） -->
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="UUIDNext" Version="4.1.2" />
    <!-- Sprint 9: #147 MailSender 迁移；使用 MailKit 替代 A 侧 SmtpClient + OpenSmtp.Mail -->
    <!-- Sprint 10.30: 升级 MailKit/MimeKit 消除 NU1902/NU1903 漏洞
         (GHSA-9j88-vvj5-vhgr / GHSA-gmc6-fwg3-75m5 / GHSA-g7hc-96xr-gvvx / CVE-2026-41319)
         Sprint 10.30b: 4.8.0 仍有 NU1902 (STARTTLS Response Injection)，需 >=4.16.0 才修复；
         升至 4.17.0 (latest) 一次性消除所有已知 MailKit/MimeKit 安全告警 -->
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <!-- Sprint 9: #158 DataCache 迁移；替换 A 侧 HttpRuntime.Cache -->
    <!-- Sprint 10.30: 升级至 8.0.1 消除 NU1903 (GHSA-qj66-m88j-hmgj) -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <!-- Sprint 10.30c: Primitives 只有 8.0.0 版本（无 8.0.1/8.0.2），
         Caching.Memory 8.0.1 要求 >=8.0.2 → NuGet 解析到 9.0.0；
         显式声明 9.0.0 消除 NU1603 警告 -->
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="9.0.0" />
  </ItemGroup>

</Project>
